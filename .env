# ═══════════════════════════════════════════════════════════════════════════════
# DocuFlow — Variables de entorno para Docker Compose (Bloque 7.1)
#
# 1. cp .env.example .env
# 2. Completar todos los valores marcados con  ← REQUERIDO
# 3. docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
# Generar con:  openssl rand -hex 32
SECRET_KEY= mi_clave_super_secreta_1234   
# ── CORS ────────────────────────────────────────────────────────────────────
# En producción: la URL pública del frontend
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER= MaricelMilde
POSTGRES_PASSWORD= Belenmilde123                          # ← REQUERIDO
POSTGRES_DB=docuflow
POSTGRES_PORT=5432                 # puerto expuesto en el host (solo dev)

# DATABASE_URL se construye automáticamente en docker-compose.yml
# Si querés sobreescribir (p.ej. para apuntar a una DB externa):
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/docuflow

# Pool de conexiones PG
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379                    # puerto expuesto en el host (solo dev)
# REDIS_URL se inyecta desde docker-compose.yml → redis://redis:6379/0

# ── Celery ──────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=2               # workers concurrentes por proceso

# ── Uvicorn ─────────────────────────────────────────────────────────────────
UVICORN_WORKERS=2                  # procesos uvicorn (≤ CPUs disponibles)
LOG_LEVEL=info                     # debug | info | warning | error

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                                                  # ← REQUERIDO
OPENAI_MODEL=gpt-4o-mini

# ── Multi-modelo (opcional) ──────────────────────────────────────────────────
LLM_PROVIDER= anthropic           # openai | anthropic | gemini | ollama
LLM_MODEL=                         # vacío = default del proveedor
ANTHROPIC_API_KEY= Maricelamilde123
GOOGLE_API_KEY=

# ── Ollama (modelos locales) ─────────────────────────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Upload ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Caché TTL ────────────────────────────────────────────────────────────────
CACHE_TTL_ANALYSIS=3600
CACHE_TTL_STATS=300

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# Generar con:  openssl rand -hex 32
NEXTAUTH_SECRET=cambia-esto-en-produccion-nextauth                     # ← REQUERIDO

# ── Email — Bloque 5.2 ───────────────────────────────────────────────────────
NOTIFICATIONS_EMAIL_ENABLED=false
EMAIL_BACKEND=smtp
EMAIL_FROM=noreply@docuflow.app
EMAIL_FROM_NAME=DocuFlow
APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# ── Integraciones externas — Bloque 5.3 ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8000/api/v1/integrations/dropbox/callback

# ── Stripe — Bloque 6.1 ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ─────────────────────────────────────────────────────────────────
# Bloque 7.3 — Observabilidad
# ─────────────────────────────────────────────────────────────────

# Sentry DSN (dejar vacío para deshabilitar)
SENTRY_DSN=

# Porcentaje de trazas a enviar a Sentry (0.0 a 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Porcentaje de perfiles de performance (requiere traces habilitado)
SENTRY_PROFILES_SAMPLE_RATE=0.05

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
