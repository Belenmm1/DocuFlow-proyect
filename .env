# ─────────────────────────────────────────────
#  DocuFlow — variables de entorno
#  Copiá este archivo como .env en la raíz del proyecto
#  NUNCA subas .env a git
# ─────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────
# Conseguila en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Base de datos ─────────────────────────────
# Local SQLite (no necesita nada instalado, ideal para desarrollo):
DATABASE_URL=sqlite:///./docuflow.db

# PostgreSQL local (si preferís Postgres en local):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/docuflow

# PostgreSQL Railway (se completa automático cuando agregás el plugin):
# DATABASE_URL=postgresql://usuario:password@host.railway.app:5432/railway

# ── Archivos ──────────────────────────────────
# Carpeta donde se guardan los uploads temporales
UPLOAD_DIR=uploads

# Tamaño máximo de archivo en MB
MAX_FILE_SIZE_MB=20

# ── App ───────────────────────────────────────
# development | production
APP_ENV=development

# ── Logging ───────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

JWT_SECRET_KEY= 99b3e04e59462fd622aaf58e6b7f6fdbbf04fea20621bbc449ba10c033682062
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
