# .env.railway — Variables de entorno para Railway
#
# CÓMO USAR:
#   Ir a cada servicio en Railway → Variables → Raw Editor
#   y pegar las variables correspondientes a ese servicio.
#
# Railway provee automáticamente:
#   DATABASE_URL  → desde el plugin PostgreSQL (variable: ${{Postgres.DATABASE_URL}})
#   REDIS_URL     → desde el plugin Redis       (variable: ${{Redis.REDIS_URL}})
#   PORT          → inyectado automáticamente por Railway
#
# ════════════════════════════════════════════════════════════════
# SERVICIO: api  +  worker
# ════════════════════════════════════════════════════════════════

# ── Conexiones (referenciar plugins de Railway) ──────────────────────────────
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
APP_NAME=DocuFlow
APP_VERSION=1.0.0
# openssl rand -hex 32
SECRET_KEY=REEMPLAZAR_CON_VALOR_REAL

# ── CORS — URL pública del frontend en Railway ───────────────────────────────
CORS_ORIGINS=https://TU_FRONTEND.up.railway.app

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=2

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOADS_DIR=/app/uploads
VECTOR_STORE_DIR=/app/vector_stores

# ── DB Pool ──────────────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Timezone ─────────────────────────────────────────────────────────────────
TIMEZONE=America/Argentina/Buenos_Aires

# ── Stripe (opcional) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Sentry (opcional) ────────────────────────────────────────────────────────
SENTRY_DSN=

# ════════════════════════════════════════════════════════════════
# SERVICIO: frontend
# ════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=https://TU_API.up.railway.app
NEXTAUTH_URL=https://TU_FRONTEND.up.railway.app
NEXTAUTH_SECRET=REEMPLAZAR_CON_VALOR_REAL
