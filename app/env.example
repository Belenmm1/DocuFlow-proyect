# ═══════════════════════════════════════════════════════════════
# DocuFlow — Variables de entorno
# Copiá este archivo como .env y completá los valores reales.
# ═══════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development        # development | production
DEBUG=false
SECRET_KEY=cambia-esto-en-produccion-con-openssl-rand-hex-32

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database — Bloque 2.4 ───────────────────────────────────────
# Desarrollo local (SQLite):
DATABASE_URL=sqlite:///./docuflow.db

# Producción (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://docuflow:password@localhost:5432/docuflow
# DATABASE_URL=postgresql+psycopg2://docuflow:password@db:5432/docuflow  # Docker

# Pool de conexiones PG (ignorado en SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Redis / Celery ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=  # si vacío, usa REDIS_URL
# CELERY_RESULT_BACKEND=  # si vacío, usa REDIS_URL

# ── Upload ──────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Caché TTL ───────────────────────────────────────────────────
CACHE_TTL_ANALYSIS=3600
CACHE_TTL_STATS=300

# ── Notificaciones Email — Bloque 5.2 ───────────────────────────
# Activar/desactivar envío de emails globalmente
NOTIFICATIONS_EMAIL_ENABLED=false

# Backend: smtp | sendgrid
EMAIL_BACKEND=smtp

# Remitente
EMAIL_FROM=noreply@docuflow.app
EMAIL_FROM_NAME=DocuFlow

# URL pública de la app (para links en los emails)
APP_URL=http://localhost:3000

# ── SMTP (cuando EMAIL_BACKEND=smtp) ────────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_TLS=true
#        (usá una "App Password" de Google, no tu contraseña real)
# Mailgun SMTP: SMTP_HOST=smtp.mailgun.org SMTP_PORT=587 SMTP_TLS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=tu@gmail.com
SMTP_PASS=tu-app-password

# ── SendGrid (cuando EMAIL_BACKEND=sendgrid) ────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# ── Integraciones Externas — Bloque 5.3 ─────────────────────────
# Google Drive
# Crear credenciales en: https://console.cloud.google.com/apis/credentials
# Tipo: "OAuth 2.0 Client ID" → "Web application"
# Agregar redirect URI autorizado: https://tuapp.railway.app/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Dropbox
# Crear app en: https://www.dropbox.com/developers/apps
# Scopes requeridos: files.metadata.read, files.content.read, account_info.read
# Agregar redirect URI: https://tuapp.railway.app/api/v1/integrations/dropbox/callback
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8000/api/v1/integrations/dropbox/callback
