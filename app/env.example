# App
APP_NAME=DocuFlow
DEBUG=true
SECRET_KEY=cambia-esto-en-produccion

# Database
DATABASE_URL=sqlite:///./docuflow.db

# OpenAI
OPENAI_API_KEY=sk-...

# Redis — NUEVAS en 2.1
REDIS_URL=redis://localhost:6379/0
# En Railway/prod con Redis addon:
# REDIS_URL=redis://:password@host:6379/0

# Celery (opcional — si vacío usa REDIS_URL)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
